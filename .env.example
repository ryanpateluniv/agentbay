# Copy to .env. Never commit .env.
# DATABASE_URL defaults to sqlite at backend/data/marketplace.db
# fake (default) = offline deterministic responses; real = forward to OpenAI. Override per run: LLM_MODE=real make dev
LLM_MODE=fake
OPENAI_API_KEY=
LLM_UPSTREAM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
# Hard caps on real provider spend (USD). A call that could exceed them is refused with 503 safety_limit.
REAL_MAX_USD_PER_SESSION=0.25
REAL_MAX_USD_PER_RUN=2.00
# subprocess | docker
RUNTIME_MODE=subprocess
# Address agents use to reach the backend (proxy + tools). For docker use http://host.docker.internal:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
PLATFORM_FEE_BPS=2000
PLATFORM_MARKUP_BPS=1000
HMAC_SECRET_EXTERNAL=dev-external-secret
CORS_ORIGINS=*
# Frontend login (Supabase). The anon key is public by design. ADMIN_EMAILS get the admin role.
SUPABASE_URL=
SUPABASE_ANON_KEY=
ADMIN_EMAILS=

# Review versions left in "submitted" when the server starts (the seeded InvoiceGenius Pro). 0 to skip.
REVIEW_ON_BOOT=1
